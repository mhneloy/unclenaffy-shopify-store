<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- liquid
      case template.suffix
        when 'un-about'
          assign page_background = settings.un_about_background
        when 'un-book'
          assign page_background = settings.un_book_background
        when 'un-prices'
          assign page_background = settings.un_prices_background
        when 'un-gallery'
          assign page_background = settings.un_gallery_background
      endcase
      if template.name == 'index'
        assign page_background = settings.un_home_background
      endif
      assign page_background = page_background | default: settings.un_background | default: '#111110'
    -%}
    <meta name="theme-color" content="{{ page_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {% if settings.favicon != blank %}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}">
    {% endif %}
    {% liquid
      case template.suffix
        when 'un-about'
          assign default_description = 'Meet Uncle Naffy and discover the approach to cuts, fades and beard work.'
        when 'un-book'
          assign default_description = 'Explore how to book a barbering appointment with Uncle Naffy.'
        when 'un-prices'
          assign default_description = 'Explore the Uncle Naffy price list for cuts, beard work and grooming add-ons.'
        when 'un-gallery'
          assign default_description = 'Browse a gallery of fades, cuts and grooming details from Uncle Naffy barbering.'
        when 'un-visit'
          assign default_description = 'Find location, opening hours and contact information for Uncle Naffy.'
        else
          assign default_description = 'Uncle Naffy barbering. Explore cuts, beard grooming and appointments.'
      endcase
    %}
    <title>{% if template.name == 'index' %}Uncle Naffy Barbering{% else %}{{ page_title | escape }}{% unless page_title contains 'Uncle Naffy' %} | Uncle Naffy{% endunless %}{% endif %}</title>
    <meta name="description" content="{{ page_description | default: default_description | escape }}">
    {% assign display_font = settings.un_display_font %}
    {% assign body_font = settings.un_body_font %}
    {% assign desktop_gutter = settings.un_desktop_gutter | default: -4 %}
    {% assign mobile_gutter = settings.un_mobile_gutter | default: -4 %}
    {{ 'unclenaffy.css' | asset_url | stylesheet_tag }}
    {% style %}
      {% if display_font.family != blank %}{{ display_font | font_face: font_display: 'swap' }}{% endif %}
      {% if body_font.family != blank %}{{ body_font | font_face: font_display: 'swap' }}{% endif %}
      :root {
        --un-bg: {{ page_background }};
        {% if settings.un_surface != blank %}--un-panel: {{ settings.un_surface }};{% endif %}
        {% if settings.un_foreground != blank %}--un-text: {{ settings.un_foreground }};{% endif %}
        {% if settings.un_muted != blank %}--un-muted: {{ settings.un_muted }};{% endif %}
        {% if settings.un_accent != blank %}--un-copper: {{ settings.un_accent }};{% endif %}
        {% if settings.un_button_background != blank %}--un-button-custom-bg: {{ settings.un_button_background }};{% endif %}
        {% if settings.un_button_text != blank %}--un-button-ink: {{ settings.un_button_text }};{% endif %}
        --un-content-width: {{ settings.un_content_width | default: 1280 }}px;
        {% if desktop_gutter >= 0 %}--un-desktop-gutter: {{ desktop_gutter }}px;{% endif %}
        {% if mobile_gutter >= 0 %}--un-mobile-gutter: {{ mobile_gutter }}px;{% endif %}
        {% if display_font.family != blank %}--un-heading: {{ display_font.family }}, {{ display_font.fallback_families | default: 'serif' }};{% endif %}
        {% if body_font.family != blank %}--un-body: {{ body_font.family }}, {{ body_font.fallback_families | default: 'sans-serif' }};{% endif %}
      }
    {% endstyle %}
    <script src="{{ 'unclenaffy.js' | asset_url }}" defer></script>
    {% render 'social-meta-tags' %}
    {{ content_for_header }}
  </head>
  <body class="un-site{% if template.name == 'index' %} un-home{% endif %}">
    <a class="un-skip" href="#MainContent">Skip to content</a>
    {% section 'un-header' %}
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
    {% section 'un-footer' %}
  </body>
</html>
