{% assign s = section.settings %}
{% assign app_blocks = section.blocks | where: 'type', '@app' %}
{% assign questions = section.blocks | where: 'type', 'question' %}
<section id="booking" class="un-section un-booking" data-un-style style="{% render 'un-section-style', section: section %}">
  <div class="un-wrap">
    <div class="un-section-head">
      <div>
        <p class="un-kicker">{{ s.eyebrow | escape }}</p>
        <h2>{{ s.heading | escape }}</h2>
      </div>
      <p>{{ s.copy | escape }}</p>
    </div>
    {% if app_blocks.size > 0 %}
      <div class="un-booking-app">
        {% for block in app_blocks %}{% render block %}{% endfor %}
      </div>
    {% else %}
      {% render 'un-booking-panel', section_settings: s %}
    {% endif %}
    {% if questions.size > 0 or s.policies != blank %}
      <div class="un-booking-help">
        <div>
          <h3>{{ s.faq_heading | escape }}</h3>
          <a href="{% render 'un-url', destination: 'visit' %}">Location &amp; opening hours</a>
          {% if settings.un_email != blank %}<p><a href="mailto:{{ settings.un_email | escape }}">{{ settings.un_email | escape }}</a></p>{% endif %}
        </div>
        <div class="un-booking-questions">
          {% for block in questions %}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title | escape }}</summary>
              <div class="un-prose">{{ block.settings.answer }}</div>
            </details>
          {% endfor %}
          {% if s.policies != blank %}<div class="un-prose">{{ s.policies }}</div>{% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name":"Uncle Naffy booking",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"The booking calendar"},
    {"type":"text","id":"heading","label":"Heading","default":"Choose your appointment."},
    {"type":"textarea","id":"copy","label":"Introduction","default":"Start with the service you want, then pick an available time in the chair."},
    {"type":"text","id":"placeholder_heading","label":"Placeholder heading","default":"Online booking is coming soon."},
    {"type":"textarea","id":"placeholder_copy","label":"Placeholder text","default":"In the meantime, check the menu to choose the cut or grooming service you want."},
    {"type":"image_picker","id":"image","label":"Placeholder photo"},
