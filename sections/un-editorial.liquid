{% assign s = section.settings %}
{% assign media_widths = '(min-width: 800px) 50vw, 92vw' %}
{% if s.banner %}{% assign media_widths = '100vw' %}{% endif %}
{% assign fallback_alt = s.demo_alt | default: 'Illustrative close-up of a barber working on a fade' %}
{% if s.main_heading %}{% assign image_loading = 'eager' %}{% endif %}
<section{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %} class="un-section un-editorial un-editorial--{{ s.alignment }}{% if s.main_heading %} un-editorial--masthead{% endif %}{% if s.banner %} un-editorial--banner{% endif %}" data-un-style style="{% render 'un-section-style', section: section %}">
  <div class="un-wrap un-editorial-grid">
    <div class="un-editorial-copy">
      {% if s.eyebrow != blank %}<p class="un-kicker">{{ s.eyebrow | escape }}</p>{% endif %}
      {% if s.main_heading %}<h1>{{ s.heading | escape }}</h1>{% else %}<h2>{{ s.heading | escape }}</h2>{% endif %}
      {% if s.founder_name != blank %}<p class="un-founder-name">{{ s.founder_name | escape }}</p>{% endif %}
      {% if s.copy != blank %}<div class="un-prose">{{ s.copy }}</div>{% endif %}
      {% if s.note != blank %}<p class="un-note">{{ s.note | escape }}</p>{% endif %}
      {% if s.cta != blank %}
        <a class="un-button un-button--outline" href="{% if s.link != blank %}{{ s.link }}{% else %}{% render 'un-url', destination: s.destination %}{% endif %}">{{ s.cta | escape }}</a>
      {% endif %}
    </div>
    <figure class="un-editorial-media un-ratio--{{ s.ratio }}">
      {% render 'un-demo-image', image: s.image, alt: s.alt, demo: s.demo_image, fallback_alt: fallback_alt, class: 'un-cover', sizes: media_widths, loading: image_loading %}
      {% if s.image == blank %}<figcaption>{{ s.demo_caption | default: 'Illustrative photography' | escape }}</figcaption>{% endif %}
    </figure>
  </div>
</section>
{% schema %}
{
  "name":"Uncle Naffy editorial",
  "settings":[
    {"type":"text","id":"anchor","label":"Section anchor"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Behind the chair"},
    {"type":"text","id":"heading","label":"Heading","default":"The craft comes first."},
    {"type":"text","id":"founder_name","label":"Confirmed founder name"},
    {"type":"checkbox","id":"main_heading","label":"Use as page heading","default":false},
    {"type":"richtext","id":"copy","label":"Copy"},
    {"type":"text","id":"note","label":"Editorial note"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"alt","label":"Image alt text"},
    {"type":"select","id":"demo_image","label":"Fallback media","default":"chair","options":[{"value":"chair","label":"Barber at work"},{"value":"portrait","label":"Barber portrait from behind"},{"value":"tools","label":"Tools"},{"value":"studio","label":"Empty barber chair"},{"value":"towel","label":"Hot towel preparation"},{"value":"crop","label":"Textured crop"},{"value":"fade","label":"Skin fade"}]},
    {"type":"text","id":"demo_alt","label":"Placeholder alt text"},
    {"type":"text","id":"demo_caption","label":"Placeholder caption","default":"Illustrative photography"},
    {"type":"select","id":"ratio","label":"Image ratio","default":"landscape","options":[{"value":"wide","label":"Wide"},{"value":"landscape","label":"Landscape"},{"value":"square","label":"Square"},{"value":"portrait","label":"Portrait"}]},
    {"type":"select","id":"alignment","label":"Image position","default":"left","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}]},
    {"type":"checkbox","id":"banner","label":"Use photo as full-width background","default":false},
    {"type":"text","id":"cta","label":"Button label"},
    {"type":"select","id":"destination","label":"Button destination","default":"about","options":[{"value":"about","label":"About"},{"value":"book","label":"Booking"},{"value":"prices","label":"Prices"},{"value":"gallery","label":"Gallery"},{"value":"visit","label":"Location"}]},
    {"type":"url","id":"link","label":"Custom button link"},
    {"type":"color","id":"background","label":"Section background"},
    {"type":"range","id":"space","label":"Desktop spacing","min":40,"max":112,"step":4,"unit":"px","default":88},
    {"type":"range","id":"mobile_space","label":"Mobile spacing","min":32,"max":72,"step":4,"unit":"px","default":52},
    {"type":"header","content":"Padding and margin"},
    {"type":"range","id":"padding_top","label":"Top padding","min":-4,"max":160,"step":4,"unit":"px","default":-4,"info":"Set to -4 to use the current default spacing."},
    {"type":"range","id":"padding_bottom","label":"Bottom padding","min":-4,"max":160,"step":4,"unit":"px","default":-4,"info":"Set to -4 to use the current default spacing."},
    {"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":-4,"max":160,"step":4,"unit":"px","default":-4,"info":"Set to -4 to use the current default spacing."},
    {"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":-4,"max":160,"step":4,"unit":"px","default":-4,"info":"Set to -4 to use the current default spacing."},
    {"type":"range","id":"margin_top","label":"Top margin","min":0,"max":120,"step":4,"unit":"px","default":0},
    {"type":"range","id":"margin_bottom","label":"Bottom margin","min":0,"max":120,"step":4,"unit":"px","default":0},
    {"type":"header","content":"Colours"},
    {"type":"color","id":"heading_color","label":"Heading colour"},
    {"type":"color","id":"body_color","label":"Body text colour"},
    {"type":"color","id":"eyebrow_color","label":"Eyebrow colour"},
    {"type":"color","id":"detail_color","label":"Caption and link colour"},
    {"type":"color","id":"button_background","label":"Button background"},
    {"type":"color","id":"button_text","label":"Button text colour"},
    {"type":"header","content":"Typography"},
    {"type":"select","id":"heading_type","label":"Heading font style","default":"default:default","options":[{"value":"default:default","label":"Default"},{"value":"default:regular","label":"Current font, regular"},{"value":"default:bold","label":"Current font, bold"},{"value":"default:italic","label":"Current font, italic"},{"value":"default:bold_italic","label":"Current font, bold italic"},{"value":"display:regular","label":"Theme display, regular"},{"value":"display:bold","label":"Theme display, bold"},{"value":"display:italic","label":"Theme display, italic"},{"value":"body:regular","label":"Theme body, regular"},{"value":"body:bold","label":"Theme body, bold"},{"value":"body:italic","label":"Theme body, italic"},{"value":"serif:regular","label":"Georgia, regular"},{"value":"sans:regular","label":"Arial, regular"},{"value":"mono:regular","label":"Monospace, regular"}]},
    {"type":"range","id":"heading_size","label":"Heading size","min":0,"max":160,"step":2,"unit":"px","default":0,"info":"Set to 0 to use the theme size."},
    {"type":"select","id":"body_type","label":"Body font style","default":"default:default","options":[{"value":"default:default","label":"Default"},{"value":"default:regular","label":"Current font, regular"},{"value":"default:bold","label":"Current font, bold"},{"value":"default:italic","label":"Current font, italic"},{"value":"default:bold_italic","label":"Current font, bold italic"},{"value":"display:regular","label":"Theme display, regular"},{"value":"display:bold","label":"Theme display, bold"},{"value":"display:italic","label":"Theme display, italic"},{"value":"body:regular","label":"Theme body, regular"},{"value":"body:bold","label":"Theme body, bold"},{"value":"body:italic","label":"Theme body, italic"},{"value":"serif:regular","label":"Georgia, regular"},{"value":"sans:regular","label":"Arial, regular"},{"value":"mono:regular","label":"Monospace, regular"}]},
    {"type":"range","id":"body_size","label":"Body size","min":0,"max":36,"step":1,"unit":"px","default":0,"info":"Set to 0 to use the theme size."},
    {"type":"select","id":"eyebrow_type","label":"Eyebrow font style","default":"default:default","options":[{"value":"default:default","label":"Default"},{"value":"default:regular","label":"Current font, regular"},{"value":"default:bold","label":"Current font, bold"},{"value":"default:italic","label":"Current font, italic"},{"value":"default:bold_italic","label":"Current font, bold italic"},{"value":"display:regular","label":"Theme display, regular"},{"value":"display:bold","label":"Theme display, bold"},{"value":"display:italic","label":"Theme display, italic"},{"value":"body:regular","label":"Theme body, regular"},{"value":"body:bold","label":"Theme body, bold"},{"value":"body:italic","label":"Theme body, italic"},{"value":"serif:regular","label":"Georgia, regular"},{"value":"sans:regular","label":"Arial, regular"},{"value":"mono:regular","label":"Monospace, regular"}]},
    {"type":"select","id":"detail_type","label":"Caption and link font style","default":"default:default","options":[{"value":"default:default","label":"Default"},{"value":"default:regular","label":"Current font, regular"},{"value":"default:bold","label":"Current font, bold"},{"value":"default:italic","label":"Current font, italic"},{"value":"default:bold_italic","label":"Current font, bold italic"},{"value":"display:regular","label":"Theme display, regular"},{"value":"display:bold","label":"Theme display, bold"},{"value":"display:italic","label":"Theme display, italic"},{"value":"body:regular","label":"Theme body, regular"},{"value":"body:bold","label":"Theme body, bold"},{"value":"body:italic","label":"Theme body, italic"},{"value":"serif:regular","label":"Georgia, regular"},{"value":"sans:regular","label":"Arial, regular"},{"value":"mono:regular","label":"Monospace, regular"}]},
    {"type":"select","id":"button_type","label":"Button font style","default":"default:default","options":[{"value":"default:default","label":"Default"},{"value":"default:regular","label":"Current font, regular"},{"value":"default:bold","label":"Current font, bold"},{"value":"default:italic","label":"Current font, italic"},{"value":"default:bold_italic","label":"Current font, bold italic"},{"value":"display:regular","label":"Theme display, regular"},{"value":"display:bold","label":"Theme display, bold"},{"value":"display:italic","label":"Theme display, italic"},{"value":"body:regular","label":"Theme body, regular"},{"value":"body:bold","label":"Theme body, bold"},{"value":"body:italic","label":"Theme body, italic"},{"value":"serif:regular","label":"Georgia, regular"},{"value":"sans:regular","label":"Arial, regular"},{"value":"mono:regular","label":"Monospace, regular"}]}
  ],
  "presets":[{"name":"Uncle Naffy editorial"}]
}
{% endschema %}
