<footer class="un-footer">
  <div class="un-wrap">
    <div class="un-footer-grid">
      <div>
        <a class="un-brand" href="{{ routes.root_url }}" aria-label="Uncle Naffy home">{% render 'un-logo' %}</a>
        {% if section.settings.tagline != blank %}<p>{{ section.settings.tagline | escape }}</p>{% endif %}
      </div>
      <div>
        <h2>Explore</h2>
        <nav aria-label="Footer navigation">{% render 'un-nav', menu: section.settings.menu %}</nav>
      </div>
      <div>
        <h2>Visit &amp; book</h2>
        {% if section.settings.hours != blank %}<p>{{ section.settings.hours | escape | newline_to_br }}</p>{% endif %}
        {% if settings.un_address != blank %}<p>{{ settings.un_address | escape | newline_to_br }}{% if settings.un_postcode != blank %}<br>{{ settings.un_postcode | escape }}{% endif %}</p>{% endif %}
        {% if settings.un_email != blank %}<a href="mailto:{{ settings.un_email | escape }}">{{ settings.un_email | escape }}</a>{% endif %}
        {% if settings.un_phone != blank %}<a href="tel:{{ settings.un_phone | remove: ' ' | escape }}">{{ settings.un_phone | escape }}</a>{% endif %}
        {% if settings.un_instagram != blank %}<a href="{{ settings.un_instagram }}">Instagram</a>{% endif %}
        {% if settings.un_tiktok != blank %}<a href="{{ settings.un_tiktok }}">TikTok</a>{% endif %}
        <a href="{% render 'un-url', destination: 'visit' %}">Location &amp; opening hours</a>
        <a href="{% render 'un-url', destination: 'book' %}">Book an appointment</a>
      </div>
    </div>
    <div class="un-footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} Uncle Naffy</span>
      <nav aria-label="Policies">
        {% if section.settings.policy_menu.links.size > 0 %}
          {% for link in section.settings.policy_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}
        {% else %}
          {% if shop.privacy_policy.body != blank %}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{% endif %}
          {% if shop.terms_of_service.body != blank %}<a href="{{ shop.terms_of_service.url }}">Terms</a>{% endif %}
        {% endif %}
      </nav>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Uncle Naffy footer",
  "settings": [
    {"type":"link_list","id":"menu","label":"Footer navigation menu"},
    {"type":"link_list","id":"policy_menu","label":"Policies menu"},
    {"type":"text","id":"tagline","label":"Tagline","default":"Precision in every detail."},
    {"type":"textarea","id":"hours","label":"Confirmed hours summary"}
  ]
}
{% endschema %}
