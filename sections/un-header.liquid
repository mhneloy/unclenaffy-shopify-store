{% assign selected_page = section.settings.booking_page %}
{% assign is_booking_destination = false %}
{% if selected_page.url == blank or selected_page.handle == 'book-appointment' %}
  {% assign is_booking_destination = true %}
{% endif %}
{% capture booking_link -%}
  {%- if is_booking_destination -%}
    {%- render 'un-url', destination: 'book', page_override: selected_page -%}
  {%- else -%}
    {{- selected_page.url -}}
  {%- endif -%}
{%- endcapture %}
<header class="un-header{% if section.settings.sticky %} un-header--sticky{% endif %}" data-un-style style="{% render 'un-section-style', section: section %}">
  <div class="un-wrap un-header-inner">
    <a class="un-brand" href="{{ routes.root_url }}" aria-label="Uncle Naffy home">{% render 'un-logo', logo: section.settings.logo %}</a>
    <nav class="un-desktop-nav" aria-label="Main navigation">{% render 'un-nav', menu: section.settings.menu %}</nav>
    <a class="un-button un-button--header" href="{{ booking_link }}"{% if is_booking_destination and template.suffix == 'un-book' %} aria-current="page"{% elsif selected_page != blank and page.id == selected_page.id %} aria-current="page"{% endif %}>{{ section.settings.cta | escape }}</a>
    <details class="un-mobile-nav" data-un-menu>
      <summary aria-label="Toggle menu"><span></span><span></span></summary>
      <nav aria-label="Mobile navigation">{% render 'un-nav', menu: section.settings.menu %}</nav>
    </details>
  </div>
</header>
{% schema %}
{
  "name": "Uncle Naffy header",
  "settings": [
    {"type":"link_list","id":"menu","label":"Navigation menu"},
    {"type":"text","id":"cta","label":"Booking label","default":"Book now"},
    {"type":"checkbox","id":"sticky","label":"Sticky header","default":true},
    {"type":"header","content":"Book Now destination"},
    {"type":"page","id":"booking_page","label":"Book Now page","info":"Leave empty to use the Book Appointment page in the theme settings."},
    {"type":"header","content":"Header logo"},
    {"type":"image_picker","id":"logo","label":"Logo image"},
    {"type":"range","id":"logo_width","label":"Logo width","min":60,"max":240,"step":5,"unit":"px","default":150},
    {"type":"range","id":"mobile_logo_width","label":"Mobile logo width","min":60,"max":150,"step":5,"unit":"px","default":110},
    {"type":"header","content":"Padding and margin"},
    {"type":"range","id":"padding_top","label":"Top padding","min":-4,"max":160,"step":4,"unit":"px","default":-4,"info":"Set to -4 to use the current default spacing."},
    {"type":"range","id":"padding_bottom","label":"Bottom padding","min":-4,"max":160,"step":4,"unit":"px","default":-4,"info":"Set to -4 to use the current default spacing."},
    {"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":-4,"max":160,"step":4,"unit":"px","default":-4,"info":"Set to -4 to use the current default spacing."},
    {"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":-4,"max":160,"step":4,"unit":"px","default":-4,"info":"Set to -4 to use the current default spacing."},
    {"type":"range","id":"margin_top","label":"Top margin","min":0,"max":120,"step":4,"unit":"px","default":0},
    {"type":"range","id":"margin_bottom","label":"Bottom margin","min":0,"max":120,"step":4,"unit":"px","default":0},
    {"type":"header","content":"Colours"},
    {"type":"color","id":"background","label":"Section background"},
    {"type":"color","id":"body_color","label":"Navigation text colour"},
    {"type":"color","id":"detail_color","label":"Active and hover link colour"},
    {"type":"color","id":"button_background","label":"Button background"},
    {"type":"color","id":"button_text","label":"Button text colour"},
    {"type":"header","content":"Typography"},
    {"type":"select","id":"body_type","label":"Body font style","default":"default:default","options":[{"value":"default:default","label":"Default"},{"value":"default:regular","label":"Current font, regular"},{"value":"default:bold","label":"Current font, bold"},{"value":"default:italic","label":"Current font, italic"},{"value":"default:bold_italic","label":"Current font, bold italic"},{"value":"display:regular","label":"Theme display, regular"},{"value":"display:bold","label":"Theme display, bold"},{"value":"display:italic","label":"Theme display, italic"},{"value":"body:regular","label":"Theme body, regular"},{"value":"body:bold","label":"Theme body, bold"},{"value":"body:italic","label":"Theme body, italic"},{"value":"serif:regular","label":"Georgia, regular"},{"value":"sans:regular","label":"Arial, regular"},{"value":"mono:regular","label":"Monospace, regular"}]},
    {"type":"range","id":"body_size","label":"Body size","min":0,"max":36,"step":1,"unit":"px","default":0,"info":"Set to 0 to use the theme size."},
    {"type":"select","id":"detail_type","label":"Caption and link font style","default":"default:default","options":[{"value":"default:default","label":"Default"},{"value":"default:regular","label":"Current font, regular"},{"value":"default:bold","label":"Current font, bold"},{"value":"default:italic","label":"Current font, italic"},{"value":"default:bold_italic","label":"Current font, bold italic"},{"value":"display:regular","label":"Theme display, regular"},{"value":"display:bold","label":"Theme display, bold"},{"value":"display:italic","label":"Theme display, italic"},{"value":"body:regular","label":"Theme body, regular"},{"value":"body:bold","label":"Theme body, bold"},{"value":"body:italic","label":"Theme body, italic"},{"value":"serif:regular","label":"Georgia, regular"},{"value":"sans:regular","label":"Arial, regular"},{"value":"mono:regular","label":"Monospace, regular"}]},
    {"type":"select","id":"button_type","label":"Button font style","default":"default:default","options":[{"value":"default:default","label":"Default"},{"value":"default:regular","label":"Current font, regular"},{"value":"default:bold","label":"Current font, bold"},{"value":"default:italic","label":"Current font, italic"},{"value":"default:bold_italic","label":"Current font, bold italic"},{"value":"display:regular","label":"Theme display, regular"},{"value":"display:bold","label":"Theme display, bold"},{"value":"display:italic","label":"Theme display, italic"},{"value":"body:regular","label":"Theme body, regular"},{"value":"body:bold","label":"Theme body, bold"},{"value":"body:italic","label":"Theme body, italic"},{"value":"serif:regular","label":"Georgia, regular"},{"value":"sans:regular","label":"Arial, regular"},{"value":"mono:regular","label":"Monospace, regular"}]}
  ]
}
{% endschema %}
