{% assign s = section.settings %}
{% assign poster = s.poster | default: s.image %}
{% assign poster_url = '' %}
{% if poster != blank %}{% assign poster_url = poster | image_url: width: 1600 %}{% endif %}
<section class="un-hero un-hero--{{ s.alignment }} un-hero--logo-{{ s.logo_position }}" style="--un-hero-height: {{ s.height }}svh; --un-overlay: {{ s.overlay }}; --un-opacity: {{ s.opacity | divided_by: 100.0 }}; --un-hero-logo: {{ s.logo_size }}px;" data-un-hero>
  <div class="un-hero-media" aria-hidden="true">
    <picture>
      {% if s.mobile_image != blank %}
        <source media="(max-width: 640px)" srcset="{{ s.mobile_image | image_url: width: 640 }} 640w, {{ s.mobile_image | image_url: width: 960 }} 960w" sizes="100vw">
      {% elsif s.image == blank and s.poster == blank %}
        <source media="(max-width: 640px)" srcset="{{ 'un-aerial-mobile.jpg' | asset_url }}">
      {% endif %}
      {% assign hero_image = s.image | default: s.poster %}
      {% render 'un-image', image: hero_image, fallback: 'un-aerial.jpg', class: 'un-hero-still', alt: '', loading: 'eager', sizes: '100vw', width: 1600, height: 1067 %}
    </picture>
    {% if s.video != blank %}
      <div class="un-hero-video">
        <template data-un-video-template>
          {{ s.video | video_tag: image_size: '1600x', autoplay: false, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', poster: poster_url }}
        </template>
      </div>
    {% endif %}
  </div>
  <div class="un-wrap un-hero-content">
    {% if s.show_logo %}<div class="un-hero-logo" aria-hidden="true">{% render 'un-logo', mark_only: true %}</div>{% endif %}
    {% if s.eyebrow != blank %}<p class="un-kicker">{{ s.eyebrow | escape }}</p>{% endif %}
    <h1>{{ s.heading | escape }}{% if s.highlight != blank %}<em>{{ s.highlight | escape }}</em>{% endif %}</h1>
    {% if s.subtitle != blank %}<p class="un-hero-description">{{ s.subtitle | escape }}</p>{% endif %}
    {% if s.cta != blank %}<a class="un-button" href="{% if s.link != blank %}{{ s.link }}{% else %}{% render 'un-url', destination: 'book' %}{% endif %}">{{ s.cta | escape }}</a>{% endif %}
  </div>
  <div class="un-wrap un-hero-bottom">
    <a href="#intro" class="un-hero-explore">Explore the shop</a>
    {% if hero_image == blank and s.video == blank %}<span>Illustrative aerial</span>{% endif %}
    {% if s.video != blank or s.animate_still %}<button type="button" class="un-motion" data-un-motion{% if s.video == blank %} data-un-pan{% endif %} hidden>{% if s.video != blank %}Pause video{% else %}Pause animation{% endif %}</button>{% endif %}
  </div>
</section>
{% schema %}
{
  "name":"Uncle Naffy hero",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Uncle Naffy Barbering"},
    {"type":"text","id":"heading","label":"Headline","default":"Precision in"},
    {"type":"text","id":"highlight","label":"Italic headline line","default":"every detail."},
    {"type":"textarea","id":"subtitle","label":"Subtitle","default":"Considered cuts, clean fades and beard work, finished with care."},
    {"type":"text","id":"cta","label":"Button label","default":"Book appointment"},
    {"type":"url","id":"link","label":"Custom button link"},
    {"type":"video","id":"video","label":"Shopify-hosted aerial video"},
    {"type":"checkbox","id":"animate_still","label":"Animate the aerial image when there is no video","default":true},
    {"type":"image_picker","id":"image","label":"Desktop image"},
    {"type":"image_picker","id":"mobile_image","label":"Mobile image"},
    {"type":"image_picker","id":"poster","label":"Video poster"},
    {"type":"color","id":"overlay","label":"Overlay colour","default":"#111110"},
    {"type":"range","id":"opacity","label":"Overlay opacity","min":0,"max":80,"step":5,"unit":"%","default":25},
    {"type":"range","id":"height","label":"Desktop viewport height","min":70,"max":90,"step":2,"unit":"%","default":88},
    {"type":"checkbox","id":"show_logo","label":"Show overlay logo","default":true},
    {"type":"range","id":"logo_size","label":"Overlay logo size","min":44,"max":140,"step":4,"unit":"px","default":60},
    {"type":"select","id":"logo_position","label":"Overlay logo position","default":"inline","options":[{"value":"inline","label":"Above headline"},{"value":"corner","label":"Upper corner"}]},
    {"type":"select","id":"alignment","label":"Content alignment","default":"center","options":[{"value":"center","label":"Centre"},{"value":"left","label":"Left"}]}
  ],
  "presets":[{"name":"Uncle Naffy hero"}]
}
{% endschema %}
