{% assign s = section.settings %}
<section class="un-section un-story" data-un-style style="{% render 'un-section-style', section: section %}">
  <div class="un-wrap">
    <div class="un-story-grid">
      <div><p class="un-kicker">{{ s.eyebrow | escape }}</p><h2>{{ s.heading | escape }}</h2></div>
      <div class="un-prose">{{ s.copy }}</div>
    </div>
    {% if s.show_team and section.blocks.size > 0 %}
      <div class="un-team">
        <h2>{{ s.team_heading | escape }}</h2>
        <div class="un-review-grid">
          {% for block in section.blocks %}
            <article class="un-team-card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}{% render 'un-image', image: block.settings.image, alt: block.settings.alt, class: 'un-cover', sizes: '(min-width: 900px) 30vw, 90vw' %}{% endif %}
              <h3>{{ block.settings.name | escape }}</h3>
              <p class="un-kicker">{{ block.settings.role | escape }}</p>
              <div class="un-prose">{{ block.settings.bio }}</div>
            </article>
          {% endfor %}
        </div>
      </div>
    {% endif %}
    {% if s.cta != blank %}<a class="un-button" href="{% render 'un-url', destination: 'book' %}">{{ s.cta | escape }}</a>{% endif %}
  </div>
</section>
{% schema %}
