{% assign s = section.settings %}
{% assign address = settings.un_address %}
{% assign postcode = settings.un_postcode %}
{% assign has_hours = false %}
{% assign has_reviews = false %}
{% for block in section.blocks %}
  {% if block.type == 'hours' and block.settings.hours != blank %}{% assign has_hours = true %}{% endif %}
  {% if block.type == 'review' and block.settings.quote != blank %}{% assign has_reviews = true %}{% endif %}
{% endfor %}
<section id="visit" class="un-section un-visit" data-un-style style="{% render 'un-section-style', section: section %}">
  <div class="un-wrap">
    <div class="un-visit-grid">
      <div class="un-visit-content">
        <p class="un-kicker">{{ s.eyebrow | escape }}</p>
        {% if s.preview or s.embedded %}<h2>{{ s.heading | escape }}</h2>{% else %}<h1>{{ s.heading | escape }}</h1>{% endif %}
        {% if s.copy != blank %}<p>{{ s.copy | escape }}</p>{% endif %}
        {% if address != blank or postcode != blank %}
          <address>{{ address | escape | newline_to_br }}{% if postcode != blank %}{% if address != blank %}<br>{% endif %}{{ postcode | escape }}{% endif %}</address>
        {% endif %}
        {% if has_hours %}
          {% if s.preview %}
            <p><a href="{% render 'un-url', destination: 'visit' %}">Opening hours</a></p>
          {% else %}
            <div id="hours" class="un-hours">
              {% if s.embedded %}<h3>Opening hours</h3>{% else %}<h2>Opening hours</h2>{% endif %}
              <dl>
                {% for block in section.blocks %}
                  {% if block.type == 'hours' and block.settings.hours != blank %}
                    <div {{ block.shopify_attributes }}><dt>{{ block.settings.day | escape }}</dt><dd>{{ block.settings.hours | escape }}</dd></div>
                  {% endif %}
                {% endfor %}
              </dl>
              {% if s.holiday != blank %}<p>{{ s.holiday | escape }}</p>{% endif %}
            </div>
          {% endif %}
        {% elsif s.hours_summary != blank %}
          <p>{{ s.hours_summary | escape | newline_to_br }}</p>
        {% endif %}
        {% if settings.un_phone != blank or settings.un_email != blank or settings.un_instagram != blank or settings.un_tiktok != blank %}
          <div class="un-visit-contact">
            {% if s.embedded %}<h3>Contact</h3>{% else %}<h2>Contact</h2>{% endif %}
            {% if settings.un_phone != blank %}<a href="tel:{{ settings.un_phone | remove: ' ' | escape }}">{{ settings.un_phone | escape }}</a>{% endif %}
            {% if settings.un_email != blank %}<a href="mailto:{{ settings.un_email | escape }}">{{ settings.un_email | escape }}</a>{% endif %}
            {% if settings.un_instagram != blank %}<a href="{{ settings.un_instagram }}">Instagram</a>{% endif %}
            {% if settings.un_tiktok != blank %}<a href="{{ settings.un_tiktok }}">TikTok</a>{% endif %}
          </div>
        {% endif %}
        <div class="un-actions">
          {% if settings.un_directions != blank %}<a class="un-button un-button--outline" href="{{ settings.un_directions }}">Get directions</a>{% endif %}
          {% if s.preview %}<a class="un-button un-button--outline" href="{% render 'un-url', destination: 'visit' %}">Location &amp; hours</a>{% endif %}
          {% if s.embedded %}
            <a class="un-button un-button--outline" href="#booking">Back to booking</a>
          {% else %}
            <a class="un-button" href="{% render 'un-url', destination: 'book' %}">Book appointment</a>
          {% endif %}
        </div>
      </div>
      <div class="un-map" data-un-map>
        {% if s.map_image != blank %}
          {% render 'un-image', image: s.map_image, alt: s.map_alt, class: 'un-cover', sizes: '(min-width: 800px) 48vw, 92vw' %}
        {% else %}
          {% render 'un-image', fallback: 'un-aerial-mobile.jpg', fallback_alt: '', class: 'un-cover un-map-demo', width: 720, height: 1000 %}
          <div class="un-map-label">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M19.5 9.5c0 5-7.5 11-7.5 11s-7.5-6-7.5-11a7.5 7.5 0 1 1 15 0Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            <span>{% if settings.un_directions != blank or s.map_url != blank %}Illustrative map preview{% else %}Illustrative map · Address coming soon{% endif %}</span>
          </div>
        {% endif %}
        {% if s.map_url != blank %}
          <button type="button" class="un-button un-map-load" data-un-map-load data-map-url="{{ s.map_url | escape }}" hidden>Load interactive map</button>
        {% endif %}
      </div>
    </div>
    {% if request.design_mode or s.preview == false %}
      {% if has_reviews and s.show_reviews %}
        <div class="un-feedback">
          <h2>Customer feedback</h2>
          <div class="un-review-grid">
            {% for block in section.blocks %}
              {% if block.type == 'review' and block.settings.quote != blank %}
                <figure class="un-review" {{ block.shopify_attributes }}>
                  <p class="un-kicker">{{ block.settings.rating }} / 5</p>
                  <blockquote>{{ block.settings.quote | escape }}</blockquote>
                  <figcaption>{{ block.settings.author | escape }}{% if block.settings.source != blank %} · {{ block.settings.source | escape }}{% endif %}</figcaption>
                </figure>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
      {% if s.show_feedback and s.privacy != blank %}
        <div class="un-feedback">
          <h2>Share your feedback</h2>
          {% assign form_id = section.id | prepend: 'UnFeedback-' %}
          {% form 'contact', id: form_id, class: 'un-feedback-form' %}
            {% if form.posted_successfully? %}<p role="status">Thanks for sharing your feedback.</p>{% endif %}
            {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
            <div class="un-form-row">
              <label>Name<input name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></label>
              <label>Email<input name="contact[email]" type="email" autocomplete="email" value="{{ form.email | escape }}" required></label>
            </div>
            <label>Rating (optional)
              <select name="contact[rating]">
                <option value="">Choose a rating</option>
                {% for rating in (1..5) %}<option value="{{ rating }}">{{ rating }} / 5</option>{% endfor %}
              </select>
            </label>
            <label>Feedback<textarea name="contact[body]" rows="5" required>{{ form.body | escape }}</textarea></label>
            <div class="un-prose">{{ s.privacy }}</div>
            <button class="un-button" type="submit">Send feedback</button>
          {% endform %}
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>
{% if s.preview == false and s.structured_data and address != blank and postcode != blank and s.city != blank %}
  <script type="application/ld+json">
    {
      "@context":"https://schema.org",
      "@type":"HairSalon",
      "name":"Uncle Naffy",
      "url":{{ canonical_url | json }},
      "address":{"@type":"PostalAddress","streetAddress":{{ address | json }},"addressLocality":{{ s.city | json }},"postalCode":{{ postcode | json }},"addressCountry":"GB"}
      {% if settings.un_phone != blank %},"telephone":{{ settings.un_phone | json }}{% endif %}
    }
  </script>
{% endif %}
{% schema %}
{
  "name":"Uncle Naffy location",
  "settings":[
    {"type":"checkbox","id":"preview","label":"Use as Home preview","default":false},
    {"type":"checkbox","id":"embedded","label":"Use as booking page section","default":false},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Location & hours"},
    {"type":"text","id":"heading","label":"Heading","default":"Visit Uncle Naffy."},
    {"type":"textarea","id":"copy","label":"Introduction","default":"The shop address and opening hours will be shared here once confirmed."},
    {"type":"textarea","id":"hours_summary","label":"Opening hours summary"},
    {"type":"text","id":"holiday","label":"Holiday hours note"},
    {"type":"image_picker","id":"map_image","label":"Static map image"},
    {"type":"text","id":"map_alt","label":"Map alt text"},
    {"type":"url","id":"map_url","label":"Optional interactive map embed URL"},
    {"type":"checkbox","id":"show_reviews","label":"Show approved reviews","default":false},
    {"type":"checkbox","id":"show_feedback","label":"Enable Shopify feedback form","default":false},
    {"type":"richtext","id":"privacy","label":"Approved feedback privacy notice"},
    {"type":"checkbox","id":"structured_data","label":"Enable verified UK business structured data","default":false},
    {"type":"text","id":"city","label":"Verified town or city"},
    {"type":"color","id":"background","label":"Section background"},
    {"type":"range","id":"space","label":"Desktop spacing","min":40,"max":112,"step":4,"unit":"px","default":88},
    {"type":"range","id":"mobile_space","label":"Mobile spacing","min":32,"max":72,"step":4,"unit":"px","default":52},
    {"type":"header","content":"Padding and margin"},
    {"type":"range","id":"padding_top","label":"Top padding","min":-4,"max":160,"step":4,"unit":"px","default":-4,"info":"Set to -4 to use the current default spacing."},
    {"type":"range","id":"padding_bottom","label":"Bottom padding","min":-4,"max":160,"step":4,"unit":"px","default":-4,"info":"Set to -4 to use the current default spacing."},
    {"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":-4,"max":160,"step":4,"unit":"px","default":-4,"info":"Set to -4 to use the current default spacing."},
    {"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":-4,"max":160,"step":4,"unit":"px","default":-4,"info":"Set to -4 to use the current default spacing."},
    {"type":"range","id":"margin_top","label":"Top margin","min":0,"max":120,"step":4,"unit":"px","default":0},
    {"type":"range","id":"margin_bottom","label":"Bottom margin","min":0,"max":120,"step":4,"unit":"px","default":0},
    {"type":"header","content":"Colours"},
    {"type":"color","id":"heading_color","label":"Heading colour"},
    {"type":"color","id":"body_color","label":"Body text colour"},
    {"type":"color","id":"eyebrow_color","label":"Eyebrow colour"},
    {"type":"color","id":"detail_color","label":"Caption and link colour"},
    {"type":"color","id":"button_background","label":"Button background"},
    {"type":"color","id":"button_text","label":"Button text colour"},
    {"type":"header","content":"Typography"},
    {"type":"select","id":"heading_type","label":"Heading font style","default":"default:default","options":[{"value":"default:default","label":"Default"},{"value":"default:regular","label":"Current font, regular"},{"value":"default:bold","label":"Current font, bold"},{"value":"default:italic","label":"Current font, italic"},{"value":"default:bold_italic","label":"Current font, bold italic"},{"value":"display:regular","label":"Theme display, regular"},{"value":"display:bold","label":"Theme display, bold"},{"value":"display:italic","label":"Theme display, italic"},{"value":"body:regular","label":"Theme body, regular"},{"value":"body:bold","label":"Theme body, bold"},{"value":"body:italic","label":"Theme body, italic"},{"value":"serif:regular","label":"Georgia, regular"},{"value":"sans:regular","label":"Arial, regular"},{"value":"mono:regular","label":"Monospace, regular"}]},
    {"type":"range","id":"heading_size","label":"Heading size","min":0,"max":160,"step":2,"unit":"px","default":0,"info":"Set to 0 to use the theme size."},
    {"type":"select","id":"body_type","label":"Body font style","default":"default:default","options":[{"value":"default:default","label":"Default"},{"value":"default:regular","label":"Current font, regular"},{"value":"default:bold","label":"Current font, bold"},{"value":"default:italic","label":"Current font, italic"},{"value":"default:bold_italic","label":"Current font, bold italic"},{"value":"display:regular","label":"Theme display, regular"},{"value":"display:bold","label":"Theme display, bold"},{"value":"display:italic","label":"Theme display, italic"},{"value":"body:regular","label":"Theme body, regular"},{"value":"body:bold","label":"Theme body, bold"},{"value":"body:italic","label":"Theme body, italic"},{"value":"serif:regular","label":"Georgia, regular"},{"value":"sans:regular","label":"Arial, regular"},{"value":"mono:regular","label":"Monospace, regular"}]},
    {"type":"range","id":"body_size","label":"Body size","min":0,"max":36,"step":1,"unit":"px","default":0,"info":"Set to 0 to use the theme size."},
    {"type":"select","id":"eyebrow_type","label":"Eyebrow font style","default":"default:default","options":[{"value":"default:default","label":"Default"},{"value":"default:regular","label":"Current font, regular"},{"value":"default:bold","label":"Current font, bold"},{"value":"default:italic","label":"Current font, italic"},{"value":"default:bold_italic","label":"Current font, bold italic"},{"value":"display:regular","label":"Theme display, regular"},{"value":"display:bold","label":"Theme display, bold"},{"value":"display:italic","label":"Theme display, italic"},{"value":"body:regular","label":"Theme body, regular"},{"value":"body:bold","label":"Theme body, bold"},{"value":"body:italic","label":"Theme body, italic"},{"value":"serif:regular","label":"Georgia, regular"},{"value":"sans:regular","label":"Arial, regular"},{"value":"mono:regular","label":"Monospace, regular"}]},
    {"type":"select","id":"detail_type","label":"Caption and link font style","default":"default:default","options":[{"value":"default:default","label":"Default"},{"value":"default:regular","label":"Current font, regular"},{"value":"default:bold","label":"Current font, bold"},{"value":"default:italic","label":"Current font, italic"},{"value":"default:bold_italic","label":"Current font, bold italic"},{"value":"display:regular","label":"Theme display, regular"},{"value":"display:bold","label":"Theme display, bold"},{"value":"display:italic","label":"Theme display, italic"},{"value":"body:regular","label":"Theme body, regular"},{"value":"body:bold","label":"Theme body, bold"},{"value":"body:italic","label":"Theme body, italic"},{"value":"serif:regular","label":"Georgia, regular"},{"value":"sans:regular","label":"Arial, regular"},{"value":"mono:regular","label":"Monospace, regular"}]},
    {"type":"select","id":"button_type","label":"Button font style","default":"default:default","options":[{"value":"default:default","label":"Default"},{"value":"default:regular","label":"Current font, regular"},{"value":"default:bold","label":"Current font, bold"},{"value":"default:italic","label":"Current font, italic"},{"value":"default:bold_italic","label":"Current font, bold italic"},{"value":"display:regular","label":"Theme display, regular"},{"value":"display:bold","label":"Theme display, bold"},{"value":"display:italic","label":"Theme display, italic"},{"value":"body:regular","label":"Theme body, regular"},{"value":"body:bold","label":"Theme body, bold"},{"value":"body:italic","label":"Theme body, italic"},{"value":"serif:regular","label":"Georgia, regular"},{"value":"sans:regular","label":"Arial, regular"},{"value":"mono:regular","label":"Monospace, regular"}]},
    {"type":"color","id":"surface_color","label":"Map, review and form background"}
  ],
  "blocks":[
    {"type":"hours","name":"Opening hours","settings":[
      {"type":"text","id":"day","label":"Day","default":"Monday"},
      {"type":"text","id":"hours","label":"Hours or Closed"}
    ]},
    {"type":"review","name":"Approved review","settings":[
      {"type":"text","id":"author","label":"Display name"},
      {"type":"text","id":"source","label":"Review source"},
      {"type":"textarea","id":"quote","label":"Approved quotation"},
      {"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5}
    ]}
  ],
  "presets":[{"name":"Uncle Naffy location"}]
}
{% endschema %}
