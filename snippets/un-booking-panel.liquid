{% assign acuity_url = settings.un_acuity_url %}
{% assign acuity_embed = settings.un_acuity_embed_url | default: acuity_url %}
{% if acuity_url != blank %}
  {% if settings.un_acuity_embed and acuity_embed != blank %}
    <iframe class="un-booking-frame" title="Uncle Naffy appointment scheduling" src="{{ acuity_embed | escape }}" width="1000" height="770" loading="lazy"></iframe>
  {% endif %}
  <a class="un-button" href="{{ acuity_url }}">Open appointment scheduler</a>
{% else %}
  <div class="un-booking-preview">
    <div class="un-booking-preview-copy">
      <h3>{{ section_settings.placeholder_heading | escape }}</h3>
      <p>{{ section_settings.placeholder_copy | escape }}</p>
      <a class="un-button un-button--outline" href="{% render 'un-url', destination: 'prices' %}">Explore the price list</a>
      {% if request.design_mode %}<p class="un-note">Use Add block in this section to choose your booking app.</p>{% endif %}
    </div>
    <figure class="un-editorial-media">
      {% render 'un-demo-image', demo: 'towel', image: section_settings.image, alt: section_settings.image_alt, fallback_alt: 'Illustrative photo of hands preparing a hot towel', class: 'un-cover', sizes: '(min-width: 800px) 35vw, 90vw' %}
      {% if section_settings.image == blank %}<figcaption>Illustrative photography</figcaption>{% endif %}
    </figure>
  </div>
{% endif %}
