{%- assign logo = logo | default: settings.un_logo -%}
{%- if logo != blank -%}
  {%- assign logo_alt = logo.alt | default: 'Uncle Naffy' -%}
  {%- assign logo_sizes = '(max-width: 900px) 33vw, 240px' -%}
  {%- if mark_only -%}{%- assign logo_sizes = '(max-width: 640px) 65vw, 448px' -%}{%- endif -%}
  {{ logo | image_url: width: 640 | image_tag: class: 'un-logo-image', widths: '80, 120, 160, 240, 320, 480, 640', sizes: logo_sizes, alt: logo_alt, loading: 'eager' }}
{%- elsif use_bundled_logo -%}
  <img class="un-logo-image un-logo-image--bundled" src="{{ 'un-naffy-logo.jpg' | asset_url }}" alt="Uncle Naffy Premium Haircare" width="1312" height="1199" decoding="async">
{%- else -%}
  <span class="un-wordmark">
    <span class="un-monogram" aria-hidden="true">UN<span>.</span></span>
    {% unless mark_only %}<span class="un-wordmark-name">UNCLE NAFFY<small>BARBERING</small></span>{% endunless %}
  </span>
{%- endif -%}
