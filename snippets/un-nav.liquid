{%- if menu != blank and menu.links.size > 0 -%}
  {%- for link in menu.links -%}
    <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
  {%- endfor -%}
{%- else -%}
  {%- assign destinations = 'home,prices,gallery,about' | split: ',' -%}
  {%- assign labels = 'Home,Price List,Gallery,About' | split: ',' -%}
  {%- for destination in destinations -%}
    {%- assign current_template = destination | prepend: 'un-' -%}
    <a href="{% render 'un-url', destination: destination %}"{% if template.suffix == current_template %} aria-current="page"{% elsif destination == 'home' and template.name == 'index' %} aria-current="page"{% endif %}>{{ labels[forloop.index0] | escape }}</a>
  {%- endfor -%}
{%- endif -%}
