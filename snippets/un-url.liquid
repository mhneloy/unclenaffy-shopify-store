{%- liquid
  case destination
    when 'home'
      echo routes.root_url
    when 'about'
      assign target_page = settings.un_about_page | default: pages['about-uncle-naffy']
      assign anchor = '#about'
    when 'book'
      assign target_page = settings.un_book_page | default: pages['book-appointment']
      assign anchor = '#booking'
    when 'prices'
      assign target_page = settings.un_prices_page | default: pages['price-list-gallery']
      assign anchor = '#prices'
    when 'gallery'
      assign target_page = settings.un_prices_page | default: pages['price-list-gallery']
      assign destination = 'prices'
      assign anchor = '#gallery'
      assign page_anchor = '#gallery'
    when 'visit'
      assign target_page = settings.un_visit_page | default: pages['location-hours-feedback']
      assign anchor = '#visit'
  endcase
  if anchor != blank
    if target_page != blank and target_page.url != blank
      assign suffix = destination | prepend: 'un-'
      echo target_page.url
      unless target_page.template_suffix == suffix
        echo '?view=' | append: suffix
      endunless
      echo page_anchor
    else
      echo routes.root_url | append: anchor
    endif
  endif
-%}
