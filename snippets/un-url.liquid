{%- liquid
  case destination
    when 'home'
      echo routes.root_url
    when 'about'
      assign handle = 'about-uncle-naffy'
      assign target_page = settings.un_about_page | default: pages[handle]
    when 'book'
      assign handle = 'book-appointment'
      assign target_page = page_override | default: settings.un_book_page | default: pages[handle]
    when 'prices'
      assign handle = 'price-list'
      assign target_page = settings.un_prices_page | default: pages[handle] | default: pages['price-list-gallery']
    when 'gallery'
      assign handle = 'gallery'
      assign target_page = settings.un_gallery_page | default: pages[handle]
    when 'visit'
      assign handle = 'book-appointment'
      assign target_page = settings.un_book_page | default: pages[handle]
      assign destination = 'book'
      assign page_anchor = '#visit'
  endcase
  if handle != blank
    assign suffix = destination | prepend: 'un-'
    if target_page != blank and target_page.url != blank
      echo target_page.url
      unless target_page.template_suffix == suffix
        echo '?view=' | append: suffix
      endunless
    else
      assign last_character = routes.root_url | slice: -1, 1
      echo routes.root_url
      unless last_character == '/'
        echo '/'
      endunless
      echo 'pages/' | append: handle | append: '?view=' | append: suffix
    endif
    echo page_anchor
  endif
-%}
